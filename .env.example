DB_USERNAME=username
DB_PASSWORD=password
DB_HOST=host
DB_PORT=0000
DB_NAME=sigsa_db
MAILER_HOST=mailer_host
MAILER_USER=mailer_user
MAILER_API_kEY=mailer_password

# Firma de los tokens de sesión. Obligatorio: sin esto el backend no arranca.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=10h

# Firebase Cloud Messaging (para notificaciones push)
# Obtener de: Firebase Console -> Project Settings -> Cloud Messaging -> Server Key
# Dejar vacío para simular en desarrollo
FCM_SERVER_KEY=